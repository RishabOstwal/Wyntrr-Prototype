TAVUS_API_KEY=your_tavus_api_key
TAVUS_PAL_ID=your_tavus_pal_id
# Recommended: use a long, stable secret to derive opaque Tavus memory participant IDs.
# If omitted, TAVUS_API_KEY is used. Changing either active secret creates a new memory identity.
TAVUS_MEMORY_TAG_SECRET=
# Optional: enable Lil Spark, which runs on LemonSlice and joins through Daily.
LEMONSLICE_API_KEY=
LEMONSLICE_AGENT_ID=
# Optional: only set this if you want to override the PAL's default face.
TAVUS_FACE_ID=
PORT=3002
LOGIN_API_URL=http://192.168.11.160:3001/video-login
VIDEO_SESSIONS_API_URL=http://192.168.11.160:3001/video/sessions
